{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-casino-game",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mini-casino-db",
      "database_id": "7aa283f3-ae4b-42bc-8337-930851021a00",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // GEMINI_API_KEY และ INWCLOUD_API_KEY ตั้งใน Cloudflare Dashboard (Variables and secrets) ไม่ใส่ในไฟล์นี้
    "GEMINI_MODEL": "gemini-3.8-flash",
    // ห้ามประกาศ key เป็น "" ตรงนี้ เพราะ deploy จะทับค่าใน Dashboard ให้ว่าง — local ใส่ใน .dev.vars
    // ── Payment Gateway (inwcloud.shop) หมวด PromptPay ────────────────
    // คีย์นี้อยู่ฝั่ง Worker เท่านั้น เบราว์เซอร์ไม่เห็น — ห้ามใส่ prefix VITE_
    // ขอคีย์/ดูเอกสารได้ที่ https://inwcloud.shop/payment-gateway
    "INWCLOUD_BASE_URL": "https://api.inwcloud.shop",
    // อัตราแลกชิปและขอบเขตยอดเติม (หน่วยบาท)
    "CHIPS_PER_THB": "10",
    "MIN_TOPUP_THB": "10",
    "MAX_TOPUP_THB": "9000"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
