{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mini-casino-game",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mini-casino-db",
      "database_id": "7aa283f3-ae4b-42bc-8337-930851021a00",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    // GEMINI (Fortune ChatBot) - production values อยูดวยใน file นี้ (เหมือน INWCLOUD_API_KEY)
    "GEMINI_API_KEY": "",
    "GEMINI_MODEL": "gemini-3.8-flash",
    // GEMINI_API_KEY / GEMINI_MODEL ห้ามประกาศเป็น "" ตรงนี้ เพราะ deploy จะทับค่าที่ตั้งไว้ใน
    // Dashboard/secret ให้ว่าง — local ใส่ใน .dev.vars, production ใช้ wrangler secret put
    // ── Payment Gateway (inwcloud.shop) หมวด PromptPay ────────────────
    // ใส่ API Key ที่ได้จาก Dashboard ของ inwcloud ที่ช่อง INWCLOUD_API_KEY แล้ว deploy อีกครั้ง
    // คีย์นี้อยู่ฝั่ง Worker เท่านั้น เบราว์เซอร์ไม่เห็น — ห้ามใส่ prefix VITE_
    // ขอคีย์/ดูเอกสารได้ที่ https://inwcloud.shop/payment-gateway
    "INWCLOUD_API_KEY": "",
    "INWCLOUD_BASE_URL": "https://api.inwcloud.shop",
    // อัตราแลกชิปและขอบเขตยอดเติม (หน่วยบาท)
    "CHIPS_PER_THB": "10",
    "MIN_TOPUP_THB": "10",
    "MAX_TOPUP_THB": "9000"
  },
  "keep_vars": true,
  "observability": {
    "enabled": true
  }
}
