# ==============================================================================
# Google OAuth 2.0 Client Configuration
# ==============================================================================
# คำแนะนำในการตั้งค่า:
# 1. ไปที่ Google Cloud Console: https://console.cloud.google.com/apis/credentials
# 2. คลิก "+ CREATE CREDENTIALS" -> เลือก "OAuth client ID"
# 3. เลือก Application type: "Web application"
# 4. ตั้งชื่อแอป เช่น "High-Low Dice Game"
# 5. ในช่อง "Authorized JavaScript origins" ให้เพิ่ม:
#    - http://localhost:5173
#    - https://mini-casino-game.songpon-official.workers.dev
# 6. ในช่อง "Authorized redirect URIs" (สามารถเว้นว่างไว้ หรือใส่ URL เดียวกันได้):
#    - http://localhost:5173
#    - https://mini-casino-game.songpon-official.workers.dev
# 7. คัดลอก Client ID (ลงท้ายด้วย .apps.googleusercontent.com) มาใส่ด้านล่างนี้:
#
# รองรับทั้ง VITE_GOOGLE_CLIENT_ID และ GOOGLE_CLIENT_ID
VITE_GOOGLE_CLIENT_ID=
# ฝั่ง Worker (ตรวจ ID token ของ /api/admin/*) — production ตั้งใน wrangler.jsonc vars, local ใส่ใน .dev.vars
GOOGLE_CLIENT_ID=

# เทพเจ้าลูกเต๋า (Gemini) — ใช้ฝั่ง Worker เท่านั้น ห้ามใส่ prefix VITE_
# local: ใส่ใน .env (wrangler dev อ่านให้) / production: wrangler secret put GEMINI_API_KEY
# AI หลัก (OpenAI-compatible) — production ตั้งใน Cloudflare Dashboard (Variables and Secrets)
AI_BASE_URL=https://example.com/v1
AI_API_KEY=
AI_MODEL=
# Gemini = fallback เมื่อ AI หลักพัง
GEMINI_API_KEY=
GEMINI_MODEL=

# ==============================================================================
# Payment Gateway (inwcloud.shop) หมวด PromptPay — เติมชิปด้วยเงินจริง
# ==============================================================================
# ขอ API Key ได้จาก Dashboard ของ inwcloud: https://inwcloud.shop/payment-gateway
# คีย์นี้ใช้ฝั่ง Worker เท่านั้น เบราว์เซอร์ไม่เห็น และห้ามใส่ prefix VITE_
# local: ใส่ใน .env / production: wrangler secret put INWCLOUD_API_KEY
#   (หรือกำหนดใน wrangler.jsonc ช่อง vars.INWCLOUD_API_KEY ก็ได้)
INWCLOUD_API_KEY=
INWCLOUD_BASE_URL=https://api.inwcloud.shop

# อัตราแลกชิปและขอบเขตยอดเติม (หน่วยบาท)
CHIPS_PER_THB=10
MIN_TOPUP_THB=20
MAX_TOPUP_THB=5000
